# ─── Database ────────────────────────────────────────────────────────────────
# Neon serverless (Replit/local dev) or RDS endpoint (AWS production)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.yourproject.supabase.co:5432/postgres

# ─── Session & Encryption ────────────────────────────────────────────────────
SESSION_SECRET=your-session-secret-here-min-32-chars
# 32-byte base64 AES-256 key: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=

# ─── AWS Cognito (required for PHI features) ─────────────────────────────────
# Hosted UI base URL, e.g. https://auth.us-east-1.amazoncognito.com
COGNITO_DOMAIN=https://your-domain.auth.us-east-1.amazoncognito.com
COGNITO_CLIENT_ID=your-cognito-app-client-id
COGNITO_CLIENT_SECRET=your-cognito-app-client-secret
COGNITO_REDIRECT_URI=https://your-app-domain.com/auth/callback
COGNITO_LOGOUT_REDIRECT_URI=https://your-app-domain.com
# Discovery URL used by the aws/ Express server:
# https://cognito-idp.<region>.amazonaws.com/<user-pool-id>
COGNITO_ISSUER_URL=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXXXXXXX

# ─── PHI Lambda API ──────────────────────────────────────────────────────────
# API Gateway URL output by CloudFormation (PhiApiUrl)
AWS_PHI_API_BASE_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/prod

# ─── Supabase (optional – used only when running on Replit) ──────────────────
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_ANON_KEY=public-anon-key
SUPABASE_SERVICE_ROLE_KEY=service-role-key
VITE_SUPABASE_URL=https://yourproject.supabase.co
VITE_SUPABASE_ANON_KEY=public-anon-key

# ─── Replit (automatically provided on Replit platform) ──────────────────────
REPLIT_DOMAINS=your-repl-domain.replit.app
REPL_ID=your-repl-id