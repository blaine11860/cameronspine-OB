# Supabase Configuration
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_ANON_KEY=public-anon-key
SUPABASE_SERVICE_ROLE_KEY=service-role-key
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.yourproject.supabase.co:5432/postgres

# Frontend Environment Variables (prefix with VITE_)
VITE_SUPABASE_URL=https://yourproject.supabase.co
VITE_SUPABASE_ANON_KEY=public-anon-key

# Session Configuration
SESSION_SECRET=your-session-secret-here
JWT_SECRET=supersecretforfallbacks

# Replit Configuration (automatically provided)
REPLIT_DOMAINS=your-repl-domain.replit.app
REPL_ID=your-repl-id